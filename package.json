## src/index.css

```css
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #02142f;
  color: #d7ebff;
}

.site-bg {
  min-height: 100vh;
  background:
    linear-gradient(rgba(0,0,0,.55), rgba(0,0,0,.55)),
    url('/hero-bg.png');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
}

.container {
  width: 90%;
  max-width: 1200px;
  margin: auto;
}

.navbar {
  padding: 20px 0;
}

.nav-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo-wrap {
  display: flex;
  align-items: center;
  gap: 15px;
}

.logo {
  width: 70px;
}

.menu {
  display: flex;
  gap: 25px;
}

.menu a {
  color: #cfe8ff;
  text-decoration: none;
  font-weight: bold;
}

.page-section {
  padding: 80px 0;
}

.page-heading {
  font-size: 58px;
  margin-bottom: 20px;
  color: #9ed0ff;
}

.small-blue {
  color: #53b7ff;
  margin-bottom: 10px;
}

.big-title {
  font-size: 44px;
  margin-bottom: 25px;
}

.content-text {
  color: #dbeaff;
  line-height: 1.9;
  margin-bottom: 40px;
}

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 50px;
  align-items: center;
}

.about-image {
  width: 100%;
  border-radius: 25px;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 25px;
}

.service-card {
  background: rgba(0,30,70,.85);
  border: 1px solid rgba(120,180,255,.25);
  padding: 35px;
  border-radius: 20px;
}

.service-icon {
  color: #8ec9ff;
  margin-bottom: 25px;
}

.service-card h3 {
  font-size: 32px;
  margin-bottom: 20px;
}

.service-card p {
  line-height: 1.8;
}

.timeline {
  display: grid;
  grid-template-columns: repeat(6,1fr);
  gap: 20px;
  margin: 60px 0;
}

.timeline-item {
  text-align: center;
}

.circle {
  width: 85px;
  height: 85px;
  border-radius: 50%;
  background: #2c69ff;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: auto;
  font-size: 28px;
  font-weight: bold;
  margin-bottom: 20px;
}

.process-box {
  background: rgba(0,30,70,.85);
  border-radius: 20px;
  padding: 40px;
  display: grid;
  gap: 18px;
}

.faq-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.faq-item {
  background: rgba(0,30,70,.85);
  border-radius: 18px;
  padding: 25px;
}

.faq-item summary {
  cursor: pointer;
  font-size: 24px;
  font-weight: bold;
}

.faq-item p {
  margin-top: 18px;
  color: #d9ebff;
}

.contact-grid {
  display: grid;
  grid-template-columns: 380px 1fr;
  gap: 40px;
}

.contact-info {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.contact-card,
.fb-btn,
.line-btn {
  background: rgba(0,30,70,.9);
  padding: 20px;
  border-radius: 16px;
}

.fb-btn {
  background: #1877f2;
  color: white;
  text-decoration: none;
  text-align: center;
}

.line-btn {
  background: #06c755;
  color: white;
  text-decoration: none;
  text-align: center;
}

.primary-btn {
  background: #2c69ff;
  color: white;
  padding: 18px 35px;
  border-radius: 14px;
  text-decoration: none;
}

.btn-group {
  display: flex;
  gap: 20px;
  margin-top: 35px;
}

.hero-page {
  padding: 140px 0;
}

.hero-title {
  font-size: 72px;
  margin-bottom: 25px;
}

.hero-text {
  font-size: 24px;
  line-height: 1.8;
}

.footer {
  text-align: center;
  padding: 30px;
  color: #9fcfff;
}

.qr {
  width: 220px;
}

@media(max-width:900px) {

  .service-grid,
  .timeline,
  .about-grid,
  .contact-grid {
    grid-template-columns: 1fr;
  }

  .menu {
    flex-wrap: wrap;
  }

  .page-heading {
    font-size: 42px;
  }

  .hero-title {
    font-size: 48px;
  }
}
```
